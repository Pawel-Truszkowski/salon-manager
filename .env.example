# Przykładowy plik zmiennych środowiskowych.
# Skopiuj jako .env.dev (lokalnie) lub .env.prod (do produkcji) i uzupełnij realnymi wartościami.

DJANGO_SETTINGS_MODULE=config.settings.development

SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Connection string do bazy, np. postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://salon:salon@db:5432/salon

POSTGRES_DB=salon
POSTGRES_USER=salon
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

RESEND_API_KEY=change-me
SALON_EMAIL=salon@example.com
DEFAULT_FROM_EMAIL=no-reply@example.com

# Bazowy URL używany do budowania linków w mailach (np. link do odwołania wizyty)
SITE_URL=http://localhost:8000

# Wymagane tylko w środowisku produkcyjnym (za ewentualnym proxy)
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Opcjonalnie — alternatywny backend SMTP zamiast Resend
# EMAIL_HOST=...
# EMAIL_PORT=...
# EMAIL_USE_TLS=...
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
