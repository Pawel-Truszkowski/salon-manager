# Przykładowy plik zmiennych środowiskowych.
# Skopiuj jako .env.dev (lokalnie) lub .env.prod (do produkcji) i uzupełnij realnymi wartościami.

DJANGO_SETTINGS_MODULE=config.settings.development

SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Connection string do bazy, np. postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://salon:salon@db:5432/salon

POSTGRES_DB=salon
POSTGRES_USER=salon
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

RESEND_API_KEY=change-me
SALON_EMAIL=salon@example.com
DEFAULT_FROM_EMAIL=no-reply@example.com

# Bazowy URL: linki w mailach (odwołanie wizyty, zaproszenie do panelu), canonical, Open Graph, JSON-LD.
# Zawsze ze schematem http(s):// — na produkcji: https://royalbeauty-studiourody.pl
SITE_URL=http://localhost:8000
